PORT=3001
DB_HOST=localhost
DB_PORT=5434
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=db_taller
JWT_SECRET=clave_secreta_tallerpro_2026
JWT_EXPIRES_IN=7200

# URL pública de la API, para armar los enlaces de los adjuntos en modo disco
API_URL=http://localhost:3001

# Almacenamiento de adjuntos. `disco` alcanza para el día a día; `s3` es lo
# que corre en producción y el endpoint explícito permite apuntar a
# Backblaze B2, Cloudflare R2, Supabase Storage o MinIO sin tocar código.
STORAGE_DRIVER=disco
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Para probar el driver s3 en local contra el MinIO del docker-compose,
# reemplaza los cinco valores de arriba por estos. El bucket se crea solo
# al levantar los contenedores y la consola queda en http://localhost:9001
#
#   STORAGE_DRIVER=s3
#   S3_ENDPOINT=http://localhost:9000
#   S3_REGION=us-east-1
#   S3_BUCKET=tallerpro
#   S3_ACCESS_KEY_ID=minioadmin
#   S3_SECRET_ACCESS_KEY=minioadmin

# Credenciales de MinIO, solo para el docker-compose de desarrollo.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
